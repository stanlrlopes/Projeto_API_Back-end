# =============================================================================
# EducaAPI — Configuração de arquivos ignorados pelo Git (.gitignore)
# =============================================================================

# Dependências (Back-End e Front-End)
node_modules/
**/node_modules/

# Artefatos de compilação e build (Back-End e Front-End)
dist/
**/dist/
build/
**/build/
*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts

# Relatórios de cobertura de testes
coverage/
**/coverage/

# Variáveis de ambiente e segredos (preservando explicitamente os .env.example)
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Logs e arquivos de diagnóstico
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Caches e diretórios temporários
.npm
.eslintcache
.cache/
.parcel-cache/
.vite/
**/node_modules/.tmp/
tmp/
temp/
*.tmp
*.temp
*.bak

# Configurações locais de IDEs e editores
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# Arquivos de sistema operacional
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Anotações pessoais, backups e rascunhos locais (não publicar no repositório público)
INSTRUCOES.md
*.bundle
*.bak


