# =============================================================================
# EducaAPI (Front-End) — Exemplo de Variáveis de Ambiente (frontend/.env.example)
# Copie este arquivo para "frontend/.env" (e opcionalmente "frontend/.env.development"
# para os atalhos de login em modo dev). NUNCA versione arquivos ".env" reais.
# =============================================================================

# URL base da API Back-End
VITE_API_URL=http://localhost:3000/api

# Nota mínima de referência para aprovação / alerta pedagógico (ODS 4)
VITE_MIN_PASSING_AVERAGE=6.0

# -----------------------------------------------------------------------------
# Variáveis opcionais exclusivas para ambiente local de desenvolvimento (vite dev)
# Utilizadas apenas pelos botões de preenchimento rápido na tela de Login em DEV.
# -----------------------------------------------------------------------------
# VITE_DEV_ADMIN_EMAIL=admin@exemplo.com
# VITE_DEV_TEACHER_EMAIL=professor@exemplo.com
# VITE_DEV_STUDENT_EMAIL=aluno@exemplo.com
# VITE_DEV_SEED_PASSWORD=senha_ficticia_dev
