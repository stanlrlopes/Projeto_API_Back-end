# =============================================================================
# EducaAPI (Back-End) — Exemplo de Variáveis de Ambiente (.env.example)
# Copie este arquivo para ".env" na raiz do projeto e preencha com os valores
# reais do seu ambiente local. NUNCA versione o arquivo ".env".
# =============================================================================

# Porta HTTP da aplicação Express (padrão: 3000)
PORT=3000

# Chave secreta para assinatura e validação de tokens JWT (obrigatória)
# Gere uma string aleatória longa e segura (ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="substitua_por_uma_chave_secreta_jwt_forte_e_exclusiva"

# String de conexão do PostgreSQL utilizada pelo Prisma ORM (execução local)
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO?schema=public
DATABASE_URL="postgresql://usuario:senha_ficticia@localhost:5432/educa_api?schema=public"

# Variáveis para execução via Docker Compose (obrigatórias ao usar docker-compose.yml)
POSTGRES_USER="usuario_postgres_ficticio"
POSTGRES_PASSWORD="substitua_por_uma_senha_forte_do_postgres"
POSTGRES_DB="educa_api"
POSTGRES_PORT=5432
